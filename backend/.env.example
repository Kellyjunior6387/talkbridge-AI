# Sentiment Insights (all optional — sensible defaults in code)
# GEMMA_MODEL=gemini-3.1-flash-lite       # model for topic extraction & issue summarization
# INSIGHTS_WINDOW_DAYS=7                   # trailing baseline length
# INSIGHTS_Z_THRESHOLD=2.0                 # std-devs above baseline to flag a spike
# INSIGHTS_MIN_SPIKE_COUNT=3               # min tags on the spike day
# INSIGHTS_HARD_MIN_COUNT=6                # cold-start absolute trip (no baseline yet)
# INSIGHTS_MIN_BASELINE_DAYS=3             # history needed before z-score is trusted

